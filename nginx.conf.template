# Định nghĩa vùng nhớ cache
proxy_cache_path /var/cache/nginx levels=1:2 keys_zone=api_cache:10m max_size=1g inactive=30d use_temp_path=off;

server {
    listen 80;
    server_name localhost;

    # ====================================================
    # 1. Location gốc (Xử lý picsum.photos)
    # ====================================================
    location / {
        proxy_pass https://picsum.photos;

        proxy_ssl_server_name on;
        proxy_ssl_name picsum.photos;
        proxy_set_header Host picsum.photos;

        proxy_redirect https://fastly.picsum.photos ${BASE_URL}/fastly;

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header User-Agent $http_user_agent;

        # --- CẤU HÌNH CACHE TỐI ƯU (Bỏ qua query string động như hmac) ---
        proxy_cache api_cache;
        proxy_cache_methods GET HEAD;
        
        # Chỉ dùng scheme, method và URI (không tính query string như hmac) làm khóa cache
        proxy_cache_key "$scheme$request_method$uri";

        proxy_cache_valid 200 301 302 30d;
        proxy_cache_valid 404 1m;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_lock on;

        add_header X-Cache-Status $upstream_cache_status;
    }

    # ====================================================
    # 2. Prefix: /fastly/ -> Chuyển tiếp tới https://fastly.picsum.photos
    # ====================================================
    location /fastly/ {
        rewrite ^/fastly(/.*)$ $1 break;

        proxy_pass https://fastly.picsum.photos;

        proxy_ssl_server_name on;
        proxy_ssl_name fastly.picsum.photos;
        proxy_set_header Host fastly.picsum.photos;

        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header User-Agent $http_user_agent;

        # --- CẤU HÌNH CACHE TỐI ƯU ---
        proxy_cache api_cache;
        proxy_cache_methods GET HEAD;
        
        # Bỏ qua query string động cho fastly
        proxy_cache_key "$scheme$request_method$uri";

        proxy_cache_valid 200 30d;
        proxy_cache_valid 404 1m;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_lock on;

        add_header X-Cache-Status $upstream_cache_status;
    }
}